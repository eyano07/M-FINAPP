<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scan des justificatifs (notes de frais) et photo jointe depuis l'appareil. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notifications push (Android 13 et plus : autorisation demandée au premier lancement). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Applications que l'on appelle : appareil photo, lecteur de PDF ou de tableur. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    </queries>

    <!-- usesCleartextTraffic : le serveur local du restaurant est souvent servi en http sur le réseau du site. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Finapp"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/raccourcis" />
        </activity>

        <!-- Fichiers téléchargés (PDF, Excel) et photos prises, transmis aux autres applications sans androidx. -->
        <provider
            android:name=".Fichiers"
            android:authorities="cd.mbsc.finapp.fichiers"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".ServiceMessages"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="notes_frais" />

        <!-- Widgets de l'écran d'accueil (18/11/2026) : voir Widgets.java. -->
        <receiver
            android:name=".WidgetNotes"
            android:exported="false"
            android:label="@string/widget_notes_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_notes_info" />
        </receiver>
        <receiver
            android:name=".WidgetTresorerie"
            android:exported="false"
            android:label="@string/widget_tresorerie_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tresorerie_info" />
        </receiver>
    </application>
</manifest>
