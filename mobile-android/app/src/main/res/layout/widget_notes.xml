        <TextView
            android:id="@+id/ligne1_bas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_doux"
            android:textSize="12sp" />
        <!-- Pipeline : DFIN · DA · Caisse · Payée (couleurs posées par Widgets.pipeline). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/seg1_1"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_segment" />
            <ImageView
                android:id="@+id/seg1_2"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
