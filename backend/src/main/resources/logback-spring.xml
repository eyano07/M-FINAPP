<?xml version="1.0" encoding="UTF-8"?>
<!--
  Journalisation : configuration par defaut de Spring Boot (console) + journal d'AUDIT dans un fichier a part.
  Le journal d'audit (logger "AUDIT") ecrit une ligne JSON par action d'utilisateur dans audit.log, avec rotation
  quotidienne (archives audit-AAAA-MM-JJ.log.gz). Il n'apparait pas dans la console (additivity=false).

  LE JOURNAL D'AUDIT NE SE SUPPRIME JAMAIS : c'est la memoire du systeme depuis sa creation. Aucune limite de
  conservation (ni maxHistory, ni totalSizeCap, ni nettoyage au demarrage) : un fichier d'archive ne disparait pas,
  quel que soit son age. Il vit dans le volume « backend_logs » (/app/data/logs), qui survit aux redemarrages et
  aux mises a jour. Voir JournalAuditPersistanceTest, qui fait echouer le build si l'une de ces regles est retiree.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <springProperty scope="context" name="AUDIT_DIR" source="app.audit.dir" defaultValue="./data/logs"/>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUDIT_DIR}/audit.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${AUDIT_DIR}/audit-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- Conservation ILLIMITEE : pas de maxHistory, pas de totalSizeCap, jamais de nettoyage. -->
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
