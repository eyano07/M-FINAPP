# ============================================================
# M-FINAPP - Variables d'environnement (exemple)
# Copier vers .env et remplacer TOUTES les valeurs CHANGE_ME.
# Ne JAMAIS committer le fichier .env.
# ============================================================

# ---- Base de donnees PostgreSQL ----
POSTGRES_DB=mbsc
POSTGRES_USER=mbsc
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_fort

# ---- Securite JWT (cle Base64, >= 256 bits) ----
# Generer : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
# Duree de vie du jeton d'acces (ms) : 1h par defaut, le refresh token prend le relais
JWT_EXPIRATION=3600000

# ---- CORS ----
CORS_ORIGINS=http://localhost,http://localhost:3000

# ---- Durcissement production ----
# Profil Spring (mettre "prod" en production : cle JWT obligatoire,
# seeder desactive, swagger reserve ADMIN)
SPRING_PROFILES_ACTIVE=prod
# Comptes de demonstration : uniquement pour une base de test. Exige
# SEED_PASSWORD (12 caracteres au moins) : aucun mot de passe par defaut.
SEED_ENABLED=false
SEED_PASSWORD=
# Swagger accessible sans authentification (developpement uniquement)
SWAGGER_PUBLIC=false

# ---- Agent IA (suggestion de compte OHADA + reformulation des libelles) ----
# Cle API OpenAI (https://platform.openai.com/api-keys). Sans cle, le
# systeme bascule automatiquement sur un mode degrade (heuristique locale).
IA_ENABLED=true
OPENAI_API_KEY=CHANGE_ME_cle_openai_sk-...
# Modele ChatGPT utilise par le backend (voir ChatGptClient / application.yml).
OPENAI_MODEL=gpt-5
# Vide = api.openai.com. A renseigner uniquement derriere un proxy compatible.
OPENAI_BASE_URL=

# ---- Compte PostgreSQL de l'application (non super-utilisateur) ----
# Cree automatiquement sur un volume de donnees vide ; installation existante :
# db/passer-au-role-application.sh. Generer : openssl rand -base64 32
DB_APP_USER=mbsc_app
DB_APP_PASSWORD=
